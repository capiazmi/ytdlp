# Copy to .env.local (dev) or .env (prod / Dokploy).
# Precedence: real environment > .env.local > .env

APP_PORT=3000

# PIN or password for the web UI. Leave empty to disable login (dev only!).
APP_PASSWORD=change-me
# Random string; signs the session cookie. Generate: openssl rand -hex 32
SESSION_SECRET=
# true in prod (served over https via Cloudflare), false for http://localhost
COOKIE_SECURE=false

# Where downloads go. The Docker image uses /data/downloads (the volume);
# leave this unset in prod. Dev:
# DOWNLOAD_DIR=./data/downloads
FILE_TTL_HOURS=24
MAX_CONCURRENT_JOBS=2

# Comma-separated; subdomains included. Empty = any site yt-dlp supports.
ALLOWED_DOMAINS=youtube.com,youtu.be

YTDLP_PATH=yt-dlp
# Typst CLI for PDF export
TYPST_PATH=typst
# Netscape cookies.txt, helps with "Sign in to confirm you're not a bot".
# In Docker put it on the volume, e.g. /data/cookies.txt
YTDLP_COOKIES_FILE=
# Run `yt-dlp -U` on container start
YTDLP_AUTO_UPDATE=false

# Scribd page (Python + Selenium + Chromium).
# Each Chrome can use 1.5-2.5 GB on large documents
SCRIBD_MAX_CONCURRENT=1
SCRIBD_TIMEOUT_MINUTES=60
# Dev only. The Docker image sets these itself; don't set them in prod.
# SCRIBD_PYTHON=.venv/bin/python   # venv with scribd/requirements.txt
# SCRIBD_SCRIPT=./scribd/run.py
# CHROME_BIN=/usr/bin/chromium     # default: chromium on PATH
# CHROMEDRIVER=/usr/bin/chromedriver

RUST_LOG=info,tower_http=warn
